<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewBag.Title - Feedback Management System</title>

    <style>
        body {
            font-family: Arial, sans-serif;
            margin: 0;
        }

        header {
            background-color: #333;
            color: white;
            padding: 15px;
        }

        header h2 {
            margin-top: 0;
        }

        nav a {
            color: white;
            margin-right: 20px;
            text-decoration: none;
        }

        main {
            padding: 30px;
            min-height: 300px;
        }

        input,
        textarea {
            font-family: Arial, sans-serif;
        }

        footer {
            background-color: #eee;
            padding: 15px;
            text-align: center;
        }
    </style>
</head>

<body>
    <header>
        <h2>Feedback Management System</h2>

        <nav>
            <a href="@Url.Action("Index", "Home")">Home</a>
            <a href="@Url.Action("Index", "Feedback")">Feedback</a>
        </nav>
    </header>

    <main>
        @RenderBody()
    </main>

    <footer>
        <p>&copy; 2026 Feedback Management System</p>
    </footer>
</body>
</html>
